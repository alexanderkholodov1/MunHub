diff --git a/tools/check-status-rule.mjs b/tools/check-status-rule.mjs
new file mode 100644
index 0000000..13ee7af
--- /dev/null
+++ b/tools/check-status-rule.mjs
@@ -0,0 +1,59 @@
+// MunHub — status-pill rule check
+//
+// `v5-production` has no build step and no test runner, which is fine for a static site right up
+// until a rule with real branches lives in it. The status pill is such a rule, and it was wrong in
+// three ways at once, so it gets the one check this branch needs:
+//
+//     node tools/check-status-rule.mjs
+//
+// It loads the SHIPPED public/js/data-manager.js in a minimal fake browser and exercises the real
+// `computeStatus` — no reimplementation, so the file under test is the file that deploys. Not
+// served: this lives outside public/, so Firebase Hosting never sees it.
+// Loads the real data-manager.js in a minimal fake browser and exercises computeStatus against
+// the exact scenarios the operator described. No mocks of the rule itself — the shipped file runs.
+import { readFileSync } from "node:fs";
+import vm from "node:vm";
+
+const src = readFileSync(process.argv[2] ?? new URL("../public/js/data-manager.js", import.meta.url).pathname, "utf8");
+const sandbox = {
+  console,
+  setInterval: () => 1,
+  clearInterval: () => {},
+  setTimeout: () => 1,
+  clearTimeout: () => {},
+  Date,
+  Math,
+  Object,
+  PERF: { REALTIME_RETENTION_MS: 480000, REALTIME_LIMIT: 5000 },
+  FirebaseManager: { getDb: () => null },
+  UIManager: { setConnectionStatus: () => {} },
+};
+vm.createContext(sandbox);
+vm.runInContext(`${src}\n;globalThis.__DM = DataManager;`, sandbox);
+const { computeStatus } = sandbox.__DM;
+
+const NOW = 1_800_000_000_000;
+const agoSec = (s) => ({ ts: NOW / 1000 - s });
+const cases = [
+  ["backend unreachable, data fresh", { backendConnected: false, latest: agoSec(5), nowMs: NOW }, "error", "Offline"],
+  ["no latest node at all", { backendConnected: true, latest: null, nowMs: NOW }, "stale", "No data"],
+  ["latest with no ts field", { backendConnected: true, latest: {}, nowMs: NOW }, "stale", "No data"],
+  ["data 5 seconds old", { backendConnected: true, latest: agoSec(5), nowMs: NOW }, "connected", "LIVE"],
+  ["data 119 seconds old", { backendConnected: true, latest: agoSec(119), nowMs: NOW }, "connected", "LIVE"],
+  ["data 5 minutes old", { backendConnected: true, latest: agoSec(300), nowMs: NOW }, "stale", "5m ago"],
+  ["data 59 minutes old (was GREEN before)", { backendConnected: true, latest: agoSec(3540), nowMs: NOW }, "stale", "59m ago"],
+  ["data 3 hours old (the reported symptom)", { backendConnected: true, latest: agoSec(10800), nowMs: NOW }, "error", "3h ago"],
+  ["data 5 days old reads in days", { backendConnected: true, latest: agoSec(432000), nowMs: NOW }, "error", "5d ago"],
+  ["clock skew: ts in the future is not negative", { backendConnected: true, latest: agoSec(-500), nowMs: NOW }, "connected", "LIVE"],
+];
+
+let failed = 0;
+for (const [name, world, status, text] of cases) {
+  const got = computeStatus(world);
+  const ok = got.status === status && got.text === text;
+  if (!ok) failed += 1;
+  console.log(`${ok ? "PASS" : "FAIL"}  ${name.padEnd(42)} -> ${got.status}/"${got.text}"${ok ? "" : `  (expected ${status}/"${text}")`}`);
+  if (ok && !got.title) { console.log("FAIL  ...missing title"); failed += 1; }
+}
+console.log(`\n${cases.length - failed}/${cases.length} passed`);
+process.exit(failed === 0 ? 0 : 1);
